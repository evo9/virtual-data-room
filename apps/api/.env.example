# Supabase transaction pooler (port 6543) - used by the app at runtime.
# pgbouncer=true is REQUIRED: without it Prisma's prepared statements collide on
# pooled connections and every query can fail with
# `prepared statement "s0" already exists` (Postgres 42P05).
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler / direct connection (port 5432) - used by prisma migrate only.
# Migrations need a non-pooled connection; never point this at 6543.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres"

# Supabase Storage (private bucket, signed URLs only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

JWT_SECRET=

# Required - the app fails to start without it. Comma-separated list of allowed
# origins (e.g. the Vercel frontend URL), no trailing slash, whitespace trimmed.
CORS_ORIGIN=http://localhost:5173
PORT=3000
